# Copy this file to ".env" and fill in your own values, OR export these
# variables directly in your shell. The real ".env" is gitignored.

# Which push backend to use: "telegram", "ntfy", or "" to disable phone alerts.
NET_WATCH_BACKEND=telegram

# --- Telegram (if NET_WATCH_BACKEND=telegram) ---
# 1. Message @BotFather, send /newbot, copy the token here.
# 2. Message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy (if NET_WATCH_BACKEND=ntfy) ---
# Pick a private, random topic and subscribe to it in the ntfy app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=net-watch-CHANGE-ME-x7q2
